PORT=4466
DATABASE_URL=postgres://polyledger:polyledger@127.0.0.1:5440/polyledger

# At least 32 random characters each, e.g. `openssl rand -base64 48`.
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Creates the first OWNER on startup when there are no users yet; leave all
# three blank to skip. OWNER_LOGIN is an email or a mobile number
# (01XXXXXXXXX or +8801XXXXXXXXX).
OWNER_NAME=
OWNER_LOGIN=
OWNER_PASSWORD=
