generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STOREKEEPER
  SUPERVISOR
  OPERATOR
  /// Passes challans at the gate and sees nothing else.
  GUARD
}

model User {
  id                 String             @id @default(uuid(7)) @db.Uuid
  name               String
  email              String?            @unique
  phone              String?            @unique
  passwordHash       String             @map("password_hash")
  role               Role
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens      RefreshToken[]
  stockDocuments     StockDocument[]
  stockLedgerEntries StockLedgerEntry[]
  salesOrders        SalesOrder[]
  jobCards           JobCard[]
  operatedEntries    ProductionEntry[]  @relation("EntryOperator")
  recordedEntries    ProductionEntry[]  @relation("EntryRecorder")
  wasteEntries       WasteEntry[]
  grindingBatches    GrindingBatch[]
  scrapSales         ScrapSale[]
  recordedChallans   DeliveryChallan[]  @relation("ChallanRecorder")
  gatePassedChallans DeliveryChallan[]  @relation("ChallanGatePasser")
  customerReturns    CustomerReturn[]
  companySettings    CompanySettings[]

  @@map("users")
}

model RefreshToken {
  id           String        @id @default(uuid(7)) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  sessionId    String        @map("session_id") @db.Uuid
  tokenHash    String        @unique @map("token_hash")
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(3)
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id])
  replacedBy   RefreshToken? @relation("Rotation", fields: [replacedById], references: [id])
  replaces     RefreshToken? @relation("Rotation")

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model IdempotencyKey {
  actorId   String   @map("actor_id") @db.Uuid
  key       String
  command   String
  response  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([actorId, key])
  @@map("idempotency_keys")
}

enum RawMaterialType {
  RESIN
  MASTERBATCH
  ADDITIVE
  REGRIND
}

model RawMaterial {
  id                String          @id @default(uuid(7)) @db.Uuid
  code              String          @unique
  name              String
  type              RawMaterialType
  minimumStockGrams Int             @map("minimum_stock_grams")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  formulaLines      FormulaLine[]

  @@map("raw_materials")
}

model Product {
  id              String           @id @default(uuid(7)) @db.Uuid
  code            String           @unique
  name            String
  pieceWeightMg   Int              @map("piece_weight_mg")
  colour          String
  piecesPerCarton Int              @map("pieces_per_carton")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  moulds          Mould[]
  formulaVersions FormulaVersion[]
  salesOrderLines SalesOrderLine[]
  jobCards        JobCard[]

  @@map("products")
}

enum MouldStatus {
  ACTIVE
  REPAIR
  RETIRED
}

model Mould {
  id              String      @id @default(uuid(7)) @db.Uuid
  code            String      @unique
  name            String
  cavities        Int
  /// Tenths of a second: 12.5 s is 125.
  cycleTimeTenths Int         @map("cycle_time_tenths")
  /// Cold runner material per shot; 0 for a hot runner.
  runnerWeightMg  Int         @default(0) @map("runner_weight_mg")
  productId       String      @map("product_id") @db.Uuid
  status          MouldStatus @default(ACTIVE)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  product         Product     @relation(fields: [productId], references: [id])
  jobCards        JobCard[]

  @@index([productId])
  @@map("moulds")
}

enum MachineStatus {
  ACTIVE
  REPAIR
  RETIRED
}

model Machine {
  id        String        @id @default(uuid(7)) @db.Uuid
  code      String        @unique
  name      String
  tonnage   Int
  status    MachineStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobCards  JobCard[]

  @@map("machines")
}

model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  phone     String
  address   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesOrders SalesOrder[]

  @@map("customers")
}

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  phone     String
  address   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  receipts StockDocument[]

  @@map("suppliers")
}

model FormulaVersion {
  id               String        @id @default(uuid(7)) @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  version          Int
  /// Runner and rejects together, in basis points: 3.50% is 350.
  wasteBasisPoints Int           @map("waste_basis_points")
  isActive         Boolean       @default(false) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  product          Product       @relation(fields: [productId], references: [id])
  lines            FormulaLine[]
  jobCards         JobCard[]

  @@unique([productId, version])
  @@unique([productId], map: "formula_versions_one_active_per_product", where: { isActive: true })
  @@map("formula_versions")
}

model FormulaLine {
  formulaVersionId String         @map("formula_version_id") @db.Uuid
  rawMaterialId    String         @map("raw_material_id") @db.Uuid
  /// Share of the piece in basis points: 2.50% is 250. Lines add up to 10000.
  basisPoints      Int            @map("basis_points")
  formulaVersion   FormulaVersion @relation(fields: [formulaVersionId], references: [id])
  rawMaterial      RawMaterial    @relation(fields: [rawMaterialId], references: [id])

  @@id([formulaVersionId, rawMaterialId])
  @@map("formula_lines")
}

enum LocationKind {
  RAW_MATERIAL_STORE
  PRODUCTION_FLOOR
  FINISHED_GOODS_STORE
  SCRAP_YARD
}

model Location {
  id            String             @id @default(uuid(7)) @db.Uuid
  code          String             @unique
  name          String
  kind          LocationKind
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  balances      StockBalance[]
  ledgerEntries StockLedgerEntry[]
  jobCards      JobCard[]

  @@map("locations")
}

enum StockDocumentKind {
  RECEIPT
  TRANSFER
  ADJUSTMENT
  OPENING
  REVERSAL
  ISSUE
  PRODUCTION
  HANDOVER
  RETURN
  WASTE
  GRINDING
  SCRAP_SALE
  SCRAP_TRANSFER
  DISPATCH
  CUSTOMER_RETURN
}

enum StockItemType {
  RAW_MATERIAL
  PRODUCT
}

model StockDocument {
  id                String             @id @default(uuid(7)) @db.Uuid
  number            String             @unique
  kind              StockDocumentKind
  supplierId        String?            @map("supplier_id") @db.Uuid
  /// Supplier challan or invoice number, receipts only.
  supplierReference String?            @map("supplier_reference")
  receivedOn        DateTime?          @map("received_on") @db.Date
  reason            String?
  reversesId        String?            @unique @map("reverses_id") @db.Uuid
  reversedAt        DateTime?          @map("reversed_at") @db.Timestamptz(3)
  jobCardId         String?            @map("job_card_id") @db.Uuid
  postedById        String             @map("posted_by_id") @db.Uuid
  postedAt          DateTime           @default(now()) @map("posted_at") @db.Timestamptz(3)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  jobCard           JobCard?           @relation(fields: [jobCardId], references: [id])
  postedBy          User               @relation(fields: [postedById], references: [id])
  reverses          StockDocument?     @relation("DocumentReversal", fields: [reversesId], references: [id])
  reversedBy        StockDocument?     @relation("DocumentReversal")
  entries           StockLedgerEntry[]
  receiptLines      ReceiptLine[]

  @@unique([supplierId, supplierReference], map: "stock_documents_one_open_receipt_per_challan", where: { kind: "RECEIPT", reversedAt: null })
  @@index([kind, postedAt])
  @@index([jobCardId])
  @@map("stock_documents")
}

model ReceiptLine {
  documentId    String        @map("document_id") @db.Uuid
  rawMaterialId String        @map("raw_material_id") @db.Uuid
  /// What the supplier billed.
  challanGrams  Int           @map("challan_grams")
  /// What our scale showed; only this goes into stock.
  receivedGrams Int           @map("received_grams")
  document      StockDocument @relation(fields: [documentId], references: [id])

  @@id([documentId, rawMaterialId])
  @@map("receipt_lines")
}

/// Append-only: database triggers refuse UPDATE, DELETE and TRUNCATE.
model StockLedgerEntry {
  id           Int               @id @default(autoincrement())
  documentId   String            @map("document_id") @db.Uuid
  itemType     StockItemType     @map("item_type")
  itemId       String            @map("item_id") @db.Uuid
  locationId   String            @map("location_id") @db.Uuid
  movementType StockDocumentKind @map("movement_type")
  grams        Int
  /// Products only.
  pieces       Int?
  reversalOfId Int?              @unique @map("reversal_of_id")
  postedById   String            @map("posted_by_id") @db.Uuid
  postedAt     DateTime          @map("posted_at") @db.Timestamptz(3)
  document     StockDocument     @relation(fields: [documentId], references: [id])
  location     Location          @relation(fields: [locationId], references: [id])
  postedBy     User              @relation(fields: [postedById], references: [id])
  reversalOf   StockLedgerEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   StockLedgerEntry? @relation("EntryReversal")

  @@index([itemType, itemId, locationId])
  @@index([documentId])
  @@map("stock_ledger")
}

/// Running totals of stock_ledger, changed only in the same transaction as
/// the ledger rows. Stock checks lock these rows.
model StockBalance {
  itemType   StockItemType @map("item_type")
  itemId     String        @map("item_id") @db.Uuid
  /// A copy of the item's code, which never changes: balances sort and
  /// search by it without reading other modules' tables.
  itemCode   String        @map("item_code")
  locationId String        @map("location_id") @db.Uuid
  grams      BigInt        @default(0)
  pieces     BigInt        @default(0)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  location   Location      @relation(fields: [locationId], references: [id])

  @@id([itemType, itemId, locationId])
  @@index([itemType, itemCode])
  @@map("stock_balances")
}

model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  type        String
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@map("outbox")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model SalesOrder {
  id                      String           @id @default(uuid(7)) @db.Uuid
  number                  String           @unique
  customerId              String           @map("customer_id") @db.Uuid
  orderDate               DateTime         @map("order_date") @db.Date
  deliveryDate            DateTime         @map("delivery_date") @db.Date
  customerPo              String?          @map("customer_po")
  notes                   String?
  status                  SalesOrderStatus @default(DRAFT)
  cancelReason            String?          @map("cancel_reason")
  /// Extra pieces each line may ship beyond its order: 2% is 200.
  overDeliveryBasisPoints Int              @default(0) @map("over_delivery_basis_points")
  /// Set when the order was closed before everything was delivered.
  shortCloseReason        String?          @map("short_close_reason")
  createdById             String           @map("created_by_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer                Customer         @relation(fields: [customerId], references: [id])
  createdBy               User             @relation(fields: [createdById], references: [id])
  lines                   SalesOrderLine[]
  jobCards                JobCard[]

  @@index([status, deliveryDate])
  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderLine {
  orderId         String     @map("order_id") @db.Uuid
  lineNo          Int        @map("line_no")
  productId       String     @map("product_id") @db.Uuid
  pieces          Int
  /// BDT x 100.
  unitPricePoisha Int?       @map("unit_price_poisha")
  /// Delivered and not sent back for replacement.
  deliveredPieces Int        @default(0) @map("delivered_pieces")
  /// Every piece sent back, whether replaced or credited.
  returnedPieces  Int        @default(0) @map("returned_pieces")
  order           SalesOrder @relation(fields: [orderId], references: [id])
  product         Product    @relation(fields: [productId], references: [id])

  @@id([orderId, lineNo])
  @@unique([orderId, productId])
  @@map("sales_order_lines")
}

enum JobCardStatus {
  PLANNED
  RELEASED
  RUNNING
  CLOSED
  CANCELLED
}

model JobCard {
  id               String            @id @default(uuid(7)) @db.Uuid
  number           String            @unique
  productId        String            @map("product_id") @db.Uuid
  mouldId          String            @map("mould_id") @db.Uuid
  machineId        String            @map("machine_id") @db.Uuid
  floorLocationId  String            @map("floor_location_id") @db.Uuid
  salesOrderId     String?           @map("sales_order_id") @db.Uuid
  /// Frozen when the card is created, like the three weights below, so later
  /// edits to the product, mould or formula never change a job in progress.
  formulaVersionId String            @map("formula_version_id") @db.Uuid
  pieceWeightMg    Int               @map("piece_weight_mg")
  cavities         Int
  runnerWeightMg   Int               @map("runner_weight_mg")
  plannedPieces    Int               @map("planned_pieces")
  plannedStartDate DateTime          @map("planned_start_date") @db.Date
  status           JobCardStatus     @default(PLANNED)
  cancelReason     String?           @map("cancel_reason")
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz(3)
  createdById      String            @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  product          Product           @relation(fields: [productId], references: [id])
  mould            Mould             @relation(fields: [mouldId], references: [id])
  machine          Machine           @relation(fields: [machineId], references: [id])
  floorLocation    Location          @relation(fields: [floorLocationId], references: [id])
  salesOrder       SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  formulaVersion   FormulaVersion    @relation(fields: [formulaVersionId], references: [id])
  createdBy        User              @relation(fields: [createdById], references: [id])
  entries          ProductionEntry[]
  wasteEntries     WasteEntry[]
  stockDocuments   StockDocument[]

  @@unique([machineId], map: "job_cards_one_running_per_machine", where: { status: "RUNNING" })
  @@unique([mouldId], map: "job_cards_one_running_per_mould", where: { status: "RUNNING" })
  @@index([status])
  @@map("job_cards")
}

enum Shift {
  A
  B
  C
}

model ProductionEntry {
  id              String                    @id @default(uuid(7)) @db.Uuid
  jobCardId       String                    @map("job_card_id") @db.Uuid
  /// The date the shift started: night shift C keeps its start date.
  shiftDate       DateTime                  @map("shift_date") @db.Date
  shift           Shift
  operatorId      String                    @map("operator_id") @db.Uuid
  shotStart       Int                       @map("shot_start")
  shotEnd         Int                       @map("shot_end")
  goodPieces      Int                       @map("good_pieces")
  rejectedPieces  Int                       @map("rejected_pieces")
  stockDocumentId String                    @unique @map("stock_document_id") @db.Uuid
  reversedAt      DateTime?                 @map("reversed_at") @db.Timestamptz(3)
  recordedById    String                    @map("recorded_by_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  jobCard         JobCard                   @relation(fields: [jobCardId], references: [id])
  operator        User                      @relation("EntryOperator", fields: [operatorId], references: [id])
  recordedBy      User                      @relation("EntryRecorder", fields: [recordedById], references: [id])
  materials       ProductionEntryMaterial[]

  @@unique([jobCardId, shiftDate, shift], map: "production_entries_one_per_shift", where: { reversedAt: null })
  @@index([jobCardId])
  @@map("production_entries")
}

/// What one entry consumed, split so runner use can be reported on its own.
model ProductionEntryMaterial {
  entryId       String          @map("entry_id") @db.Uuid
  rawMaterialId String          @map("raw_material_id") @db.Uuid
  pieceGrams    Int             @map("piece_grams")
  runnerGrams   Int             @map("runner_grams")
  entry         ProductionEntry @relation(fields: [entryId], references: [id])

  @@id([entryId, rawMaterialId])
  @@map("production_entry_materials")
}

enum WasteType {
  RUNNER
  REJECT
  PURGE
  SWEEPINGS
}

/// Waste weighed in sacks at the machine, into one REGRIND material at a
/// scrap yard. Runners and rejects were already consumed by backflush; purge
/// and sweepings also consume floor material when recorded.
model WasteEntry {
  id              String           @id @default(uuid(7)) @db.Uuid
  jobCardId       String           @map("job_card_id") @db.Uuid
  /// The date the shift started: night shift C keeps its start date.
  shiftDate       DateTime         @map("shift_date") @db.Date
  shift           Shift
  wasteMaterialId String           @map("waste_material_id") @db.Uuid
  scrapLocationId String           @map("scrap_location_id") @db.Uuid
  stockDocumentId String           @unique @map("stock_document_id") @db.Uuid
  reversedAt      DateTime?        @map("reversed_at") @db.Timestamptz(3)
  recordedById    String           @map("recorded_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  jobCard         JobCard          @relation(fields: [jobCardId], references: [id])
  recordedBy      User             @relation(fields: [recordedById], references: [id])
  lines           WasteEntryLine[]

  @@unique([jobCardId, shiftDate, shift], map: "waste_entries_one_per_shift", where: { reversedAt: null })
  @@index([jobCardId])
  @@map("waste_entries")
}

model WasteEntryLine {
  entryId   String     @map("entry_id") @db.Uuid
  wasteType WasteType  @map("waste_type")
  grams     Int
  entry     WasteEntry @relation(fields: [entryId], references: [id])

  @@id([entryId, wasteType])
  @@map("waste_entry_lines")
}

/// One batch through the grinder: unground regrind or scrapped products in
/// from a scrap yard, ground regrind out to a raw material store.
model GrindingBatch {
  id               String        @id @default(uuid(7)) @db.Uuid
  stockDocumentId  String        @unique @map("stock_document_id") @db.Uuid
  scrapLocationId  String        @map("scrap_location_id") @db.Uuid
  storeLocationId  String        @map("store_location_id") @db.Uuid
  inputItemType    StockItemType @map("input_item_type")
  inputItemId      String        @map("input_item_id") @db.Uuid
  /// Products only; their input grams are pieces x piece weight.
  inputPieces      Int?          @map("input_pieces")
  inputGrams       Int           @map("input_grams")
  outputMaterialId String        @map("output_material_id") @db.Uuid
  outputGrams      Int           @map("output_grams")
  groundOn         DateTime      @map("ground_on") @db.Date
  reversedAt       DateTime?     @map("reversed_at") @db.Timestamptz(3)
  recordedById     String        @map("recorded_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  recordedBy       User          @relation(fields: [recordedById], references: [id])

  @@index([groundOn])
  @@map("grinding_batches")
}

model ScrapSale {
  id              String          @id @default(uuid(7)) @db.Uuid
  stockDocumentId String          @unique @map("stock_document_id") @db.Uuid
  buyerName       String          @map("buyer_name")
  soldOn          DateTime        @map("sold_on") @db.Date
  scrapLocationId String          @map("scrap_location_id") @db.Uuid
  reversedAt      DateTime?       @map("reversed_at") @db.Timestamptz(3)
  recordedById    String          @map("recorded_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  recordedBy      User            @relation(fields: [recordedById], references: [id])
  lines           ScrapSaleLine[]

  @@index([soldOn])
  @@map("scrap_sales")
}

model ScrapSaleLine {
  saleId           String        @map("sale_id") @db.Uuid
  lineNo           Int           @map("line_no")
  itemType         StockItemType @map("item_type")
  itemId           String        @map("item_id") @db.Uuid
  /// Products only; their grams are pieces x piece weight.
  pieces           Int?
  grams            Int
  pricePerKgPoisha Int           @map("price_per_kg_poisha")
  amountPoisha     Int           @map("amount_poisha")
  sale             ScrapSale     @relation(fields: [saleId], references: [id])

  @@id([saleId, lineNo])
  @@map("scrap_sale_lines")
}

enum GatePassStatus {
  PENDING
  PASSED
}

/// Goods out of a finished goods store against one sales order. Its number
/// is its stock document number (DC-000001).
model DeliveryChallan {
  id              String                @id @default(uuid(7)) @db.Uuid
  number          String                @unique
  stockDocumentId String                @unique @map("stock_document_id") @db.Uuid
  orderId         String                @map("order_id") @db.Uuid
  customerId      String                @map("customer_id") @db.Uuid
  fromLocationId  String                @map("from_location_id") @db.Uuid
  vehicleNumber   String                @map("vehicle_number")
  driverName      String                @map("driver_name")
  driverPhone     String                @map("driver_phone")
  deliveryAddress String                @map("delivery_address")
  notes           String?
  dispatchedOn    DateTime              @map("dispatched_on") @db.Date
  gatePassStatus  GatePassStatus        @default(PENDING) @map("gate_pass_status")
  gatePassedAt    DateTime?             @map("gate_passed_at") @db.Timestamptz(3)
  gatePassedById  String?               @map("gate_passed_by_id") @db.Uuid
  reversedAt      DateTime?             @map("reversed_at") @db.Timestamptz(3)
  recordedById    String                @map("recorded_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  recordedBy      User                  @relation("ChallanRecorder", fields: [recordedById], references: [id])
  gatePassedBy    User?                 @relation("ChallanGatePasser", fields: [gatePassedById], references: [id])
  lines           DeliveryChallanLine[]
  returns         CustomerReturn[]

  @@index([orderId])
  @@index([customerId, dispatchedOn])
  @@index([gatePassStatus])
  @@map("delivery_challans")
}

model DeliveryChallanLine {
  challanId      String          @map("challan_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  pieces         Int
  /// Sent back by customer returns that are not reversed.
  returnedPieces Int             @default(0) @map("returned_pieces")
  challan        DeliveryChallan @relation(fields: [challanId], references: [id])

  @@id([challanId, productId])
  @@map("delivery_challan_lines")
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  QUALITY
}

/// REPLACE: the customer still wants the pieces, so they count as not
/// delivered again. CREDIT: the customer is credited and the order is done.
enum ReturnSettlement {
  REPLACE
  CREDIT
}

/// Pieces back from a customer against a challan that passed the gate. Its
/// number is its stock document number (CRN-000001).
model CustomerReturn {
  id              String               @id @default(uuid(7)) @db.Uuid
  number          String               @unique
  stockDocumentId String               @unique @map("stock_document_id") @db.Uuid
  challanId       String               @map("challan_id") @db.Uuid
  toLocationId    String               @map("to_location_id") @db.Uuid
  reason          ReturnReason
  settlement      ReturnSettlement
  returnedOn      DateTime             @map("returned_on") @db.Date
  reversedAt      DateTime?            @map("reversed_at") @db.Timestamptz(3)
  recordedById    String               @map("recorded_by_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  challan         DeliveryChallan      @relation(fields: [challanId], references: [id])
  recordedBy      User                 @relation(fields: [recordedById], references: [id])
  lines           CustomerReturnLine[]

  @@index([challanId])
  @@map("customer_returns")
}

model CustomerReturnLine {
  returnId  String         @map("return_id") @db.Uuid
  productId String         @map("product_id") @db.Uuid
  pieces    Int
  return    CustomerReturn @relation(fields: [returnId], references: [id])

  @@id([returnId, productId])
  @@map("customer_return_lines")
}

/// A single row (id 1): the company details printed on delivery challans.
model CompanySettings {
  id          Int      @id @default(1)
  name        String
  address     String
  phone       String
  /// Business Identification Number, 13 digits; printed only when set.
  bin         String?
  updatedById String   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   User     @relation(fields: [updatedById], references: [id])

  @@map("company_settings")
}
