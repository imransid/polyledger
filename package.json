{
  "name": "polyledger",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev": "pnpm --filter @polyledger/shared build && pnpm --parallel --filter @polyledger/shared --filter @polyledger/api --filter @polyledger/office dev",
    "dev:api": "pnpm --filter @polyledger/shared build && pnpm --parallel --filter @polyledger/shared --filter @polyledger/api dev",
    "dev:office": "pnpm --filter @polyledger/shared build && pnpm --filter @polyledger/office dev",
    "dev:tablet": "pnpm --filter @polyledger/shared build && pnpm --filter @polyledger/tablet start",
    "db:seed:demo": "pnpm --filter @polyledger/shared build && pnpm --filter @polyledger/api seed:demo",
    "api:client": "pnpm --filter @polyledger/api openapi && pnpm --filter @polyledger/office api:generate && pnpm --filter @polyledger/tablet api:generate",
    "build": "pnpm -r build",
    "test": "pnpm --filter @polyledger/shared test && pnpm --filter @polyledger/office test && pnpm --filter @polyledger/tablet test && pnpm --filter @polyledger/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
